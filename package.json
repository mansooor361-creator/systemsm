{
  "name": "daaix-desktop",
  "productName": "DaAIx",
  "version": "1.6.6",
  "description": "DaAIx — Legal Knowledge Base Desktop (قواعد المعرفة القانونية)",
  "main": "main/main.js",
  "author": "DaAIx (smartk-ai.com)",
  "license": "Proprietary",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test": "node tests/run.js"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jimp": "^0.22.12",
    "jsdom": "^31.0.0"
  },
  "build": {
    "appId": "com.smartkai.daaix",
    "productName": "DaAIx",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office"
    }
  }
}
