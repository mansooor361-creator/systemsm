        {
          "id": "sa-ruling-labor-1",
          "type": "ruling",
          "title": {
            "ar": "حكم عمالي — مكافأة نهاية الخدمة والاستقالة",
            "en": "Labor Ruling — End-of-Service Award and Resignation"
          },
          "issuer": {
            "ar": "المحكمة العمالية",
            "en": "Labor Court"
          },
          "number": "قضية عمالية 1234/1444",
          "date": "1444/09/03هـ",
          "status": "final",
          "version": 1,
          "summary": {
            "ar": "حكم قضائي في استحقاق مكافأة نهاية الخدمة عند الاستقالة بعد خدمة متصلة.",
            "en": "Judgment on end-of-service award entitlement upon resignation."
          },
          "versionHistory": [
            {
              "version": 1,
              "date": "1444/09/03هـ",
              "change": {
                "ar": "الإصدار الأصلي",
                "en": "Original issue"
              },
              "by": "—"
            }
          ],
          "articles": [
            {
              "num": "الوقائع",
              "title": {
                "ar": "الوقائع",
                "en": "Facts"
              },
              "text": "تقدم العامل بدعوى عمالية تطالب بمكافأة نهاية خدمة بعد استقالته من العمل بعد خدمة متصلة تجاوزت عشر سنوات."
            },
            {
              "num": "الحكم",
              "title": {
                "ar": "الحكم",
                "en": "Judgment"
              },
              "text": "استناداً إلى المادة (74) من نظام العمل، فإن العامل الذي استقال بعد خدمة متصلة تجاوزت عشر سنوات يستحق مكافأة نهاية الخدمة كاملة، ويكون الفصل غير مشروع ما لم يثبت صاحب العمل السبب المشروع، عملاً بالمادة (77)."
            }
          ],
          "relations": [
            {
              "type": "cites",
              "target": "sa-labor-law",
              "note": {
                "ar": "استناد على المادتين (74) و(77)",
                "en": "Based on Articles 74 and 77"
              }
            }
          ],
          "sources": [
            {
              "title": "بوابة القضاء",
              "url": "https://judicial.gov.sa"
            }
          ],
          "body": "# حكم عمالي\n\nالموضوع: استحقاق مكافأة نهاية الخدمة.",
